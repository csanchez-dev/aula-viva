# Copia este archivo a .env (en la raíz del proyecto) y rellena los valores.

# --- API ---
PORT=3000
NODE_ENV=development
# Origen del frontend (CORS y cookies)
WEB_ORIGIN=http://localhost:5173
# Proxies delante de la API: 0 en local; 2 en producción (Netlify → Render)
TRUST_PROXY=0

# --- Base de datos (coincide con docker-compose.yml) ---
DATABASE_URL=postgres://aula:aula@localhost:5433/aula_viva

# --- Autenticación ---
# Genera uno largo y aleatorio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# --- IA ---
# "mock" funciona sin clave y sin coste (contenido de ejemplo). "anthropic" usa la API real.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Modelo para contenido educativo (preciso) y para temas visuales (rápido y barato)
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

# --- Plan freemium: generaciones con IA por día ---
QUOTA_FREE_PER_DAY=10
QUOTA_PRO_PER_DAY=200

# --- Beta privada ---
# Formato: correo:código,correo:código. Vacío = registro abierto. No lo subas nunca al repositorio.
BETA_INVITES=
# Correos que pueden ver el panel de actividad (#/actividad), separados por comas.
BETA_ADMIN_EMAILS=
BETA_START=2026-11-06
BETA_END=2026-11-11
BETA_DAILY_GOAL=5
