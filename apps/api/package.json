{
  "name": "@aula-viva/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST de Aula Viva (arquitectura limpia: dominio, casos de uso, infraestructura, HTTP).",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:prod": "node dist/migrate.js && node dist/main.js",
    "build": "tsup",
    "migrate": "tsx --env-file-if-exists=../../.env src/infrastructure/db/migrate.ts",
    "make-admin": "tsx --env-file-if-exists=../../.env src/infrastructure/db/make-admin.ts"
  },
  "dependencies": {
    "@aula-viva/ai": "*",
    "@aula-viva/shared": "*",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "ts-fsrs": "~5.4.2",
    "unpdf": "~1.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/pg": "^8.15.2",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3"
  }
}
